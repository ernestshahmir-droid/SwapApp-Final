<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:orientation="vertical">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#1D9E75"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Session"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Swap Session"
            android:textColor="#D1FAE5"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- VIDEO -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <TextureView
            android:id="@+id/textureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>


    <!-- RATING AFTER CALL -->

    <LinearLayout
        android:id="@+id/layoutVideoRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session Complete"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rate your skill partner"
            android:textColor="#6B7280"
            android:textSize="15sp" />


        <RatingBar
            android:id="@+id/videoRatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:numStars="5"
            android:rating="0"
            android:stepSize="1" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitVideoRating"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Submit Rating &amp; Complete"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#1D9E75"
            app:cornerRadius="12dp" />

    </LinearLayout>


    <!-- VIDEO CONTROLS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111827"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="Mute"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#374151" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:text="Switch"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#374151" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndCall"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="End Session"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#DC3545" />

    </LinearLayout>

</LinearLayout>