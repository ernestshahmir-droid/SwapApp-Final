<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- SKILL TITLE -->
        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skill"
            android:textColor="#111827"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- PARTNER -->
        <TextView
            android:id="@+id/tvSessionPartner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Partner"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <!-- STATUS -->
        <TextView
            android:id="@+id/tvSessionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Pending"
            android:textColor="#BA7517"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ACCEPT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceptSession"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:text="Accept Request"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#1D9E75"
            app:cornerRadius="10dp" />

        <!-- CANCEL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRequest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Cancel Request"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            app:backgroundTint="#DC3545"
            app:cornerRadius="10dp" />

        <!-- VIDEO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoinVideo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Join Live Session"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#0F6E56"
            app:cornerRadius="10dp" />

        <!-- END SESSION -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkCompleted"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="End Session"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            app:backgroundTint="#BA7517"
            app:cornerRadius="10dp" />

        <!-- RATING -->
        <LinearLayout
            android:id="@+id/layoutRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rate your partner"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:numStars="5"
                android:stepSize="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitRating"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Submit Rating"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1D9E75"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <!-- REPORT ISSUE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReportIssue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Report Issue"
            android:textAllCaps="false"
            android:textColor="#993C1D"
            android:visibility="gone"
            app:backgroundTint="#FAECE7"
            app:cornerRadius="10dp"
            app:strokeColor="#993C1D"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>